<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
   version="4.0">
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
    
    <welcome-file-list>
        <welcome-file>Accueil.jsp</welcome-file>
    </welcome-file-list>
   
    <servlet>
        <servlet-name>clientServlet</servlet-name>
        <servlet-class>com.test.monprojetjsp.servlet.clientServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>clientServlet</servlet-name>
        <url-pattern>/clientServlet</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>fraisEnvoiServlet</servlet-name>
        <servlet-class>com.test.monprojetjsp.servlet.fraisEnvoiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>fraisEnvoiServlet</servlet-name>
        <url-pattern>/fraisEnvoiServlet</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>envoyerServlet</servlet-name>
        <servlet-class>com.test.monprojetjsp.servlet.envoyerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>envoyerServlet</servlet-name>
        <url-pattern>/envoyerServlet</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>tauxServlet</servlet-name>
        <servlet-class>com.test.monprojetjsp.servlet.tauxServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>tauxServlet</servlet-name>
        <url-pattern>/tauxServlet</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>PDFServlet</servlet-name>
        <servlet-class>com.test.monprojetjsp.servlet.PDFServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PDFServlet</servlet-name>
        <url-pattern>/pdf</url-pattern>
    </servlet-mapping>
    <servlet>
        <servlet-name>loginServlet</servlet-name>
        <servlet-class>com.test.monprojetjsp.servlet.loginServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>loginServlet</servlet-name>
        <url-pattern>/loginServlet</url-pattern>
    </servlet-mapping>
    
    <servlet>
        <servlet-name>logoutServlet</servlet-name>
        <servlet-class>com.test.monprojetjsp.servlet.logoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>logoutServlet</servlet-name>
        <url-pattern>/logoutServlet</url-pattern>
    </servlet-mapping>
    
    <servlet>
    <servlet-name>RecetteServlet</servlet-name>
    <servlet-class>com.test.monprojetjsp.servlet.RecetteServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RecetteServlet</servlet-name>
        <url-pattern>/recetteServlet</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>EmailServlet</servlet-name>
        <servlet-class>com.test.monprojetjsp.servlet.EmailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>EmailServlet</servlet-name>
        <url-pattern>/emailServlet</url-pattern>
    </servlet-mapping>
</web-app>
